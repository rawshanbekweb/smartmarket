# ─── SMART MARKET — environment configuration ───────────────────────────────
# Copy to apps/api/.env (local dev) or .env (docker compose) and fill in values.
# NEVER commit real secrets.

# Runtime: development | test | production
NODE_ENV=development

# DEMO mode shows the demo banner, enables the occupancy/payment simulators
# and allows `npm run db:seed`. Must be false in production with real data.
DEMO_MODE=true

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/smart_market?schema=public

# API
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Auth — use a long random value (e.g. `openssl rand -hex 48`)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN_HOURS=12
# true behind HTTPS (production)
COOKIE_SECURE=false

# Internal API key used by the vision (AI) service to push occupancy results
VISION_API_KEY=CHANGE_ME_INTERNAL_VISION_KEY

# Background alert worker interval (seconds)
ALERT_WORKER_INTERVAL_SECONDS=15

# Docker compose only
POSTGRES_PASSWORD=CHANGE_ME
